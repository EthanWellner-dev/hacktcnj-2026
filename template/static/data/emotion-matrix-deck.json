{
  "name": "The Emotion Matrix Deck",
  "version": "1.0",
  "description": "A collection of multimodal emotion detection flashcards combining facial expressions and ElevenLabs audio cues.",
  "cards": [
    {
      "id": "card_01",
      "imageSrc": "/static/images/faces/smile_narrow_eyes.png",
      "audioSrc": "/static/audio/elevenlabs/001_passive_aggressive.mp3",
      "transcriptHint": "Wow, that's so great for you.",
      "options": [
        "Genuinely Happy",
        "Passive-Aggressive",
        "Confused",
        "Exhausted"
      ],
      "correctAnswerIndex": 1,
      "feedbackText": "The visual smile conflicted with narrowed eyes and a strained vocal tone, indicating hidden hostility and passive-aggressive sentiment."
    },
    {
      "id": "card_02",
      "imageSrc": "/static/images/faces/wide_eyes_looking_away.png",
      "audioSrc": "/static/audio/elevenlabs/002_anxious.mp3",
      "transcriptHint": "No no, everything is totally fine!",
      "options": [
        "Excited",
        "Angry",
        "Anxious/Lying",
        "Bored"
      ],
      "correctAnswerIndex": 2,
      "feedbackText": "The averted gaze combined with rapid, high-pitched speech is a classic sign of anxiety and potential dishonesty."
    },
    {
      "id": "card_03",
      "imageSrc": "/static/images/faces/flat_expression.png",
      "audioSrc": "/static/audio/elevenlabs/003_sarcasm.mp3",
      "transcriptHint": "I'm absolutely thrilled.",
      "options": [
        "Excited",
        "Genuinely Happy",
        "Sarcastic/Bored",
        "Angry"
      ],
      "correctAnswerIndex": 2,
      "feedbackText": "A flat, lifeless facial expression paired with monotone delivery strongly indicates sarcasm or disinterest."
    },
    {
      "id": "card_04",
      "imageSrc": "/static/images/faces/furrowed_brow_open_mouth.png",
      "audioSrc": "/static/audio/elevenlabs/004_confused.mp3",
      "transcriptHint": "Wait, what did you just say?",
      "options": [
        "Confident",
        "Confused",
        "Amused",
        "Determined"
      ],
      "correctAnswerIndex": 1,
      "feedbackText": "The furrowed brow and open mouth, combined with hesitant speech tone, clearly convey confusion and uncertainty."
