    {
      "id": "card_05",
      "imageSrc": "/static/images/faces/tight_lips_clenched_jaw.png",
      "audioSrc": "/static/audio/elevenlabs/005_angry.mp3",
      "transcriptHint": "That's... just great. Really.",
      "options": [
        "Joyful",
        "Disappointed",
        "Angry/Frustrated",
        "Sad"
      ],
      "correctAnswerIndex": 2,
      "feedbackText": "Tightened jaw muscles and pursed lips indicate suppressed anger or frustration, especially when paired with a strained vocal tone."
    },
    {
      "id": "card_06",
      "imageSrc": "/static/images/faces/drooping_eyes_downturned_mouth.png",
      "audioSrc": "/static/audio/elevenlabs/006_sad.mp3",
      "transcriptHint": "Yeah, I guess that's fine...",
      "options": [
        "Content",
        "Happy",
        "Sad/Resigned",
        "Indifferent"
      ],
      "correctAnswerIndex": 2,
      "feedbackText": "Drooping eyelids and a downturned mouth with a quiet, defeated vocal tone are unmistakable signs of sadness or resignation."
    },
    {
      "id": "card_07",
      "imageSrc": "/static/images/faces/raised_eyebrows_wide_eyes.png",
      "audioSrc": "/static/audio/elevenlabs/007_surprised.mp3",
      "transcriptHint": "Oh! I didn't expect that at all!",
      "options": [
        "Calm",
        "Skeptical",
        "Surprised",
        "Bored"
      ],
      "correctAnswerIndex": 2,
      "feedbackText": "Raised eyebrows and wide-open eyes with elevated vocal pitch perfectly capture genuine surprise and excitement."
    },
    {
      "id": "card_08",
      "imageSrc": "/static/images/faces/one_eyebrow_raised_smirk.png",
      "audioSrc": "/static/audio/elevenlabs/008_skeptical.mp3",
      "transcriptHint": "Sure, that makes total sense.",
      "options": [
        "Trusting",
        "Happy",
        "Skeptical/Doubtful",
        "Sympathetic"
      ],
      "correctAnswerIndex": 2,
      "feedbackText": "A raised eyebrow and smirk combined with sarcastic intonation signal skepticism and disbelief."
    },
    {
      "id": "card_09",
      "imageSrc": "/static/images/faces/tension_around_eyes.png",
      "audioSrc": "/static/audio/elevenlabs/009_strained.mp3",
      "transcriptHint": "I'm fine. Everything is fine.",
      "options": [
        "Relaxed",
        "Peaceful",
        "Strained/Stressed",
        "Calm"
      ],
      "correctAnswerIndex": 2,
      "feedbackText": "Tension around the eyes (crow's feet) combined with measured, controlled speech indicates internal stress being suppressed."
    },
    {
      "id": "card_10",
      "imageSrc": "/static/images/faces/genuine_smile_crinkled_eyes.png",
      "audioSrc": "/static/audio/elevenlabs/010_genuinely_happy.mp3",
      "transcriptHint": "That's wonderful news!",
      "options": [
        "Disappointed",
        "Fearful",
        "Genuinely Happy",
        "Contemptuous"
      ],
      "correctAnswerIndex": 2,
      "feedbackText": "A genuine Duchenne smile with crinkled eyes and natural vocal warmth is the hallmark of authentic happiness."
